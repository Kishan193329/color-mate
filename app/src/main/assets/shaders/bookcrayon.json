{
	"name": "crayon", 
	"shader": "shaders/booknewcrayon.fsh",
	"autoblurmaps": true, 
    
    "inputs": {
        "overlay": {
        	"path": ["assets/crayon1.jpg","assets/crayon2.jpg","assets/crayon3.jpg","assets/crayon4.jpg"],
			"mipmaps": true,
			"repeat": true
		},
        "background": {
        	"path": "assets/booksheet_art3.jpg",
			"mipmaps": true,
			"repeat": true
		},
		"noise": {
        	"path": "assets/pencil_disturb.jpg",
			"mipmaps": true,
			"repeat": true
        },
        "lut": {
            "global_lut": true
        }
    },
    
    "uvmatrix": {
    	"type": "randomfree",
    	"allowxflip": true,
    	"allowyflip": true, 
    	"scale": 1.1,
    	"scale_random": 0.3
    }
}
