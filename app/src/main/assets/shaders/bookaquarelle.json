{
	"name": "aquarelle",
	"shader": "shaders/bookaquarelle.fsh",
	"autoblurmaps": true, 
    
    "inputs": {
        "overlay": {
        	"path": ["assets/aquablue2.jpg","assets/aquablue3.jpg","assets/aquablue4.jpg"],
			"mipmaps": true,
			"repeat": true
		},
        "papertex": {
            "path": ["assets/booksheet_art4.jpg", "assets/booksheet_art5.jpg"],
            "mipmaps": true,
            "repeat": true
        },
        "lut": {
            "global_lut": true
        }
    },
    
    "uvmatrix": {
    	"type": "randomfree",
    	"allowxflip": true,
    	"allowyflip": true, 
    	"scale": 1.1,
    	"scale_random": 0.3
    }
}
