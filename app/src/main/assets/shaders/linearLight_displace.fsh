uniform sampler2D tex;
uniform sampler2D outline;
uniform sampler2D overlay;
varying highp vec2 texCoord;
varying highp vec2 texCoordTransformed;
uniform highp vec2 randomOffset;
void main ()
{
  mediump vec4 r;
  mediump vec4 y;
  mediump vec2 g;
  mediump float x;
  highp vec2 b;
  b = (texCoordTransformed + randomOffset);
  highp float a;
  a = 0.0;
  for (lowp int z = -2; z <= 2; z++) {
    lowp vec2 _;
    _.x = -2.0;
    _.y = float(z);
    mediump vec4 A;
    highp vec2 Y;
    Y = (b + (_ * 0.001));
    A = texture2D (overlay, Y);
    mediump float R;
    R = dot (A.xyz, vec3(0.33333, 0.33333, 0.33333));
    a = (a + R);
    lowp vec2 X;
    X.x = -1.0;
    X.y = float(z);
    mediump vec4 W;
    highp vec2 Z;
    Z = (b + (X * 0.001));
    W = texture2D (overlay, Z);
    mediump float o;
    o = dot (W.xyz, vec3(0.33333, 0.33333, 0.33333));
    a = (a + o);
    lowp vec2 O;
    O.x = 0.0;
    O.y = float(z);
    mediump vec4 I;
    highp vec2 i;
    i = (b + (O * 0.001));
    I = texture2D (overlay, i);
    mediump float l;
    l = dot (I.xyz, vec3(0.33333, 0.33333, 0.33333));
    a = (a + l);
    lowp vec2 S;
    S.x = 1.0;
    S.y = float(z);
    mediump vec4 G;
    highp vec2 B;
    B = (b + (S * 0.001));
    G = texture2D (overlay, B);
    mediump float c;
    c = dot (G.xyz, vec3(0.33333, 0.33333, 0.33333));
    a = (a + c);
    lowp vec2 d;
    d.x = 2.0;
    d.y = float(z);
    mediump vec4 e;
    highp vec2 f;
    f = (b + (d * 0.001));
    e = texture2D (overlay, f);
    mediump float h;
    h = dot (e.xyz, vec3(0.33333, 0.33333, 0.33333));
    a = (a + h);
  };
  highp float j;
  j = ((a / 25.0) - 0.5);
  x = j;
  highp vec2 k;
  k = (((texCoord - vec2(0.5, 0.5)) * x) * 0.1);
  g = k;
  lowp vec4 m;
  highp vec2 n;
  n = (texCoord + g);
  m = texture2D (tex, n);
  y = m;
  lowp vec4 p;
  highp vec2 q;
  q = (texCoord + g);
  p = texture2D (outline, q);
  r = p;
  highp vec2 s;
  s = (texCoordTransformed + randomOffset);
  mediump vec3 t;
  t = (y.xyz * r.x);
  lowp vec3 u;
  u = texture2D (overlay, s).xyz;
  mediump float v;
  if ((u.x < 0.5)) {
    lowp float C;
    C = (2.0 * u.x);
    v = max (((t.x + C) - 1.0), 0.0);
  } else {
    lowp float D;
    D = (2.0 * (u.x - 0.5));
    v = min ((t.x + D), 1.0);
  };
  mediump float E;
  if ((u.y < 0.5)) {
    lowp float F;
    F = (2.0 * u.y);
    E = max (((t.y + F) - 1.0), 0.0);
  } else {
    lowp float H;
    H = (2.0 * (u.y - 0.5));
    E = min ((t.y + H), 1.0);
  };
  mediump float J;
  if ((u.z < 0.5)) {
    lowp float K;
    K = (2.0 * u.z);
    J = max (((t.z + K) - 1.0), 0.0);
  } else {
    lowp float L;
    L = (2.0 * (u.z - 0.5));
    J = min ((t.z + L), 1.0);
  };
  mediump vec3 M;
  M.x = v;
  M.y = E;
  M.z = J;
  mediump vec4 N;
  N.w = 1.0;
  N.xyz = M;
  gl_FragColor = N;
}

