{
	"name": "acrylic",
	"shader": "shaders/bookacryl1.fsh",
	"autoblurmaps": true, 
    
    "inputs": {
        "overlay": {
        	"path": "assets/acrylic_sheet.jpg",
			"mipmaps": true,
			"repeat": true
		},
        "noise": {
        	"path": "assets/pencil_disturb.jpg",
			"mipmaps": true,
			"repeat": true
		},
        "paper": {
            "path": "assets/booksheet_art3.jpg",
            "mipmaps": true,
            "repeat": true
        },
        "lut": {
            "global_lut": true
        }
    },
        
    "uvmatrix": {
    	"type": "randomfree",
    	"allowxflip": true,
    	"allowyflip": true,
        "allowxrandom": true,
        "allowyrandom": false,
    	"scale": 1.0,
    	"scale_random": 0.10
    }
}
