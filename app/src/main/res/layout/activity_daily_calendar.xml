<?xml version="1.0" encoding="utf-8"?>
<!--
  Daily Challenge (redesigned 2026-10-14).

  Edge-to-edge like Home (the toolbar takes the status-bar inset in code). The hero card leads
  with the streak, then two quiet stat pills, then ONE action — today's picture. The calendar is
  monochrome: finished = violet wash + tick, today = ring, selected = heavy ring, future = faded.
  The tiles underneath belong to the selected date, so a heading names that date instead of a
  badge repeating the same number on every tile.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cal_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cm_bg_paper">

    <LinearLayout
        android:id="@+id/cal_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/cm_gutter"
        android:paddingTop="@dimen/cm_space_3"
        android:paddingBottom="@dimen/cm_space_3">

        <RelativeLayout
            android:id="@+id/cal_back"
            android:layout_width="@dimen/cm_icon_btn"
            android:layout_height="@dimen/cm_icon_btn"
            android:background="@drawable/cm_icon_btn"
            android:elevation="2dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_centerInParent="true"
                android:contentDescription="@string/todo"
                android:src="@drawable/round_arrow_back_24"
                app:tint="@color/cm_ink" />
        </RelativeLayout>

        <TextView
            style="@style/CmText.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/cm_space_3"
            android:layout_weight="1"
            android:text="@string/daily_title"
            android:textSize="22sp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/cal_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/cal_toolbar"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="@dimen/cm_gutter"
        android:paddingBottom="@dimen/cm_space_7"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ───── Hero: streak ───── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/cm_hero_gradient"
                android:elevation="@dimen/cm_elev_card"
                android:orientation="vertical"
                android:padding="@dimen/cm_space_5">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/daily_flame"
                        android:textSize="36sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/cm_space_3"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/cal_streak"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/quicksand_bold"
                            android:fontFeatureSettings="tnum"
                            android:includeFontPadding="false"
                            android:textColor="@color/cm_surface"
                            android:textSize="28sp" />

                        <TextView
                            android:id="@+id/cal_streak_sub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/quicksand_regular"
                            android:includeFontPadding="false"
                            android:textColor="#E6FFFFFF"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Two quiet stats, equal width -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cm_space_4"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_plan_unselected"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/cm_space_3"
                        android:paddingVertical="@dimen/cm_space_2">

                        <TextView
                            style="@style/CmText.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/daily_today"
                            android:textColor="#CCFFFFFF" />

                        <TextView
                            android:id="@+id/cal_countdown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/quicksand_bold"
                            android:fontFeatureSettings="tnum"
                            android:includeFontPadding="false"
                            android:textColor="@color/cm_surface"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/cm_space_2"
                        android:layout_weight="1"
                        android:background="@drawable/bg_plan_unselected"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/cm_space_3"
                        android:paddingVertical="@dimen/cm_space_2">

                        <TextView
                            style="@style/CmText.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/daily_total_label"
                            android:textColor="#CCFFFFFF" />

                        <TextView
                            android:id="@+id/cal_total"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/quicksand_bold"
                            android:fontFeatureSettings="tnum"
                            android:includeFontPadding="false"
                            android:textColor="@color/cm_surface"
                            android:textSize="16sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/cal_play_today"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="@dimen/cm_space_4"
                    android:background="@drawable/cm_btn_white_pill"
                    android:fontFamily="@font/quicksand_bold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/daily_play_today"
                    android:textColor="@color/cm_violet"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- ───── Month ───── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cm_space_6"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/cal_month"
                    style="@style/CmText.Section"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/cal_prev"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/cm_icon_btn"
                    android:contentDescription="@string/todo"
                    android:elevation="1dp"
                    android:padding="9dp"
                    android:rotation="180"
                    android:src="@drawable/right_arrow"
                    app:tint="@color/cm_ink_2" />

                <ImageView
                    android:id="@+id/cal_next"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="@dimen/cm_space_2"
                    android:background="@drawable/cm_icon_btn"
                    android:contentDescription="@string/todo"
                    android:elevation="1dp"
                    android:padding="9dp"
                    android:src="@drawable/right_arrow"
                    app:tint="@color/cm_ink_2" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cal_weekdays"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cm_space_3"
                android:orientation="horizontal" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/cal_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cm_space_2"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <!-- ───── The selected date's pictures ───── -->
            <TextView
                android:id="@+id/cal_list_header"
                style="@style/CmText.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cm_space_6" />

            <TextView
                android:id="@+id/cal_list_sub"
                style="@style/CmText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/cal_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cm_space_3"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <TextView
                android:id="@+id/cal_footer"
                style="@style/CmText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cm_space_4"
                android:gravity="center" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</RelativeLayout>
