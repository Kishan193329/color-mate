<?xml version="1.0" encoding="utf-8"?>
<!--
  Splash. Everything here is drawn by the app — the downloaded GIF it replaced cost a network
  round trip, a disk cache and megabytes on every cold start, and said nothing the brand couldn't
  say for itself. Views start invisible; SplashActivity.playIntro() springs them in.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cm_splash_bg">

    <com.colourmate.paintbynumber.widget.PaintParticleView
        android:id="@+id/splashPaint"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--
      The 3D layer, above the 2D paint but BELOW the wordmark, and transparent-backed so the
      gradient still shows through. It starts invisible: SplashActivity fades it in only once the
      page reports it has drawn a frame, so a slow or WebGL-less device simply keeps the 2D splash
      and the user never sees a blank rectangle.
    -->
    <WebView
        android:id="@+id/splash3d"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@android:color/transparent"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!--
          The app icon is the mark. It already carries its own rounded shape, background and the
          half-numbered / half-painted butterfly that says what this app is, so it is shown whole
          rather than tucked inside a gradient tile — framing a finished icon twice reads as a
          mistake. Loaded in code (see SplashActivity.loadMark) because the PNG is 560px in a
          density-less folder and android:src would decode it upscaled, on the main thread.
        -->
        <FrameLayout
            android:id="@+id/splashMark"
            android:layout_width="116dp"
            android:layout_height="116dp"
            android:alpha="0">

            <ImageView
                android:id="@+id/splashIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null" />
        </FrameLayout>

        <TextView
            android:id="@+id/splashWordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cm_space_5"
            android:alpha="0"
            android:fontFamily="@font/titanone_regular"
            android:includeFontPadding="false"
            android:text="@string/brand_name"
            android:textColor="@color/cm_ink"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/splashTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cm_space_2"
            android:alpha="0"
            android:fontFamily="@font/quicksand_semibold"
            android:includeFontPadding="false"
            android:letterSpacing="0.14"
            android:text="@string/splash_tagline"
            android:textAllCaps="true"
            android:textColor="@color/cm_ink_2"
            android:textSize="@dimen/cm_text_caption" />
    </LinearLayout>

    <!-- Loading. The bar sweeps; the text says what is actually happening. -->
    <LinearLayout
        android:id="@+id/splashLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="@dimen/splash_bottom_margin"
        android:alpha="0"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/splashTrack"
            android:layout_width="132dp"
            android:layout_height="5dp"
            android:background="@drawable/cm_splash_track"
            android:clipChildren="true">

            <View
                android:id="@+id/progressBar"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:background="@drawable/cm_splash_track_fill" />
        </FrameLayout>

        <TextView
            android:id="@+id/ads"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cm_space_3"
            android:fontFamily="@font/quicksand_semibold"
            android:includeFontPadding="false"
            android:text="@string/splash_preparing"
            android:textColor="@color/cm_ink_3"
            android:textSize="@dimen/cm_text_caption" />
    </LinearLayout>

</FrameLayout>
