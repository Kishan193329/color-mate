<?xml version="1.0" encoding="utf-8"?>
<!-- The featured "Hit" picture (admin -> Make Hit image). Hidden until /index.php/App/hit returns
     one. Locked: dimmed colour preview + padlock + countdown. Unlocked: Play opens the reveal game. -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/hit_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/main_content_padding_h"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:visibility="gone"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/cm_radius_lg"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <androidx.cardview.widget.CardView
            android:layout_width="88dp"
            android:layout_height="88dp"
            app:cardCornerRadius="@dimen/cm_radius_md"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/hit_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/white"
                android:contentDescription="@string/todo"
                android:scaleType="centerCrop" />

            <FrameLayout
                android:id="@+id/hit_lock"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#8C201636">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/todo"
                    android:src="@drawable/cm_ic_lock" />
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/cm_chip_gold"
                android:fontFamily="@font/quicksand_bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="@string/hit_badge"
                android:textColor="@color/cm_gold_ink"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/hit_title"
                style="@style/CmText.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/hit_countdown"
                style="@style/CmText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/quicksand_bold"
                android:textColor="@color/cm_violet" />
        </LinearLayout>

        <TextView
            android:id="@+id/hit_play"
            style="@style/CmButton.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/hit_play" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
