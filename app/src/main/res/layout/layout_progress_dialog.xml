<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parent"
    android:layout_width="@dimen/progress_dialog_width"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="@dimen/progress_dialog_corner_radius"
    app:cardElevation="@dimen/progress_dialog_elevation">

    <LinearLayout
        android:id="@+id/interior_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="@dimen/progress_dialog_padding"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/progress_dialog_margin_top"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="@dimen/progress_dialog_image_size"
            android:layout_height="@dimen/progress_dialog_image_size"
            android:layout_gravity="center_horizontal"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottie"
            android:layout_width="@dimen/progress_dialog_lottie_size"
            android:layout_height="@dimen/progress_dialog_lottie_size"
            android:layout_gravity="center_horizontal"

            app:lottie_rawRes="@raw/drawing_and_coloring"
            app:lottie_loop="true" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="@dimen/progress_dialog_progress_size"
            android:layout_height="@dimen/progress_dialog_progress_size"
            android:layout_gravity="center_horizontal"
            android:indeterminateTint="@color/hint_text_color"
            android:visibility="gone" />


        <TextView
            android:id="@+id/message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/progress_dialog_msg_margin_top"
            android:fontFamily="@font/quicksand_bold"
            android:text="Hello"
            android:textColor="@android:color/black"
            android:textSize="@dimen/progress_dialog_msg_text_size"
             />

    </LinearLayout>

</androidx.cardview.widget.CardView>
