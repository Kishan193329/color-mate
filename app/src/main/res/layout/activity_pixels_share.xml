<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <!-- ================= TOP BAR ================= -->
    <androidx.cardview.widget.CardView
        android:id="@+id/topBarCard"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        android:layout_alignParentTop="true"
        android:backgroundTint="@color/white"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        app:cardUseCompatPadding="false">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/toolbar_padding_horizontal"
            android:paddingEnd="@dimen/toolbar_padding_horizontal">

            <LinearLayout
                android:id="@+id/leftBar"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">


                <LinearLayout
                    android:id="@+id/iv_back"
                    android:layout_width="@dimen/toolbar_back_btn_size"
                    android:layout_height="@dimen/toolbar_back_btn_size"
                    android:background="@drawable/bg_circle_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:padding="@dimen/share_back_btn_padding">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/todo"
                        android:src="@drawable/round_arrow_back_24"
                        app:tint="#111111" />
                </LinearLayout>


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/toolbar_title_margin_start"
                    android:fontFamily="@font/quicksand_semibold"
                    android:includeFontPadding="false"
                    android:text="@string/share_title"
                    android:textColor="#191919"
                    android:textSize="@dimen/toolbar_title_size" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_done"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/share_done_btn_height"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_done_chip"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/quicksand_bold"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingStart="@dimen/share_done_btn_padding_h"
                android:paddingEnd="@dimen/share_done_btn_padding_h"
                android:text="@string/share_done"
                android:textColor="#111111"
                android:textSize="@dimen/share_done_btn_text_size" />
        </RelativeLayout>
    </androidx.cardview.widget.CardView>


    <!-- ================= IMAGE PREVIEW (CARD) ================= -->
    <androidx.cardview.widget.CardView
        android:id="@+id/previewCard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomSheet"
        android:layout_below="@id/topBarCard"
        android:layout_marginHorizontal="@dimen/share_preview_margin_h"
        android:layout_marginVertical="@dimen/share_preview_margin_v"
        android:backgroundTint="@color/white"
        app:cardCornerRadius="@dimen/share_card_corner_radius"
        app:cardElevation="@dimen/share_card_elevation"
        app:cardUseCompatPadding="true">

        <ImageView
            android:id="@+id/iv_imageViewPainting"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />
    </androidx.cardview.widget.CardView>


    <!-- ================= BOTTOM SHARE SHEET ================= -->
    <androidx.cardview.widget.CardView
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/icBanner"
        android:backgroundTint="@color/white"
        app:cardCornerRadius="@dimen/share_card_corner_radius"
        app:cardElevation="@dimen/share_card_elevation"
        app:cardUseCompatPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/share_card_inner_padding"
            android:paddingTop="@dimen/share_sheet_padding_top"
            android:paddingBottom="@dimen/share_card_inner_padding">

            <!-- small handle -->
            <View
                android:layout_width="@dimen/share_handle_width"
                android:layout_height="@dimen/share_handle_height"
                android:layout_marginBottom="@dimen/share_handle_margin_bottom"
                android:background="@drawable/bg_bottom_sheet_handle" />

            <TextView
                android:id="@+id/tv_share_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/quicksand_semibold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/share_desc"
                android:textColor="@color/medium_gray"
                android:textSize="@dimen/share_desc_text_size" />

            <LinearLayout
                android:id="@+id/share_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/share_btn_container_margin_top"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Messenger -->
                <androidx.cardview.widget.CardView
                    android:layout_width="@dimen/share_icon_size"
                    android:layout_height="@dimen/share_icon_size"
                    android:layout_margin="@dimen/share_icon_card_margin"
                    android:backgroundTint="#F6F6F6"
                    app:cardCornerRadius="@dimen/share_icon_card_corner_radius"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/iv_imageViewSave"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:contentDescription="@null"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:padding="@dimen/share_icon_card_padding"
                        android:src="@drawable/ic_messenger" />
                </androidx.cardview.widget.CardView>

                <!-- WhatsApp -->
                <androidx.cardview.widget.CardView
                    android:layout_width="@dimen/share_icon_size"
                    android:layout_height="@dimen/share_icon_size"
                    android:layout_margin="@dimen/share_icon_card_margin"
                    android:backgroundTint="#F6F6F6"
                    app:cardCornerRadius="@dimen/share_icon_card_corner_radius"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/ib_whatsapp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:contentDescription="@null"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:padding="@dimen/share_icon_card_padding"
                        android:src="@drawable/ic_whatsapp" />
                </androidx.cardview.widget.CardView>

                <!-- Instagram -->
                <androidx.cardview.widget.CardView
                    android:layout_width="@dimen/share_icon_size"
                    android:layout_height="@dimen/share_icon_size"
                    android:layout_margin="@dimen/share_icon_card_margin"
                    android:backgroundTint="#F6F6F6"
                    app:cardCornerRadius="@dimen/share_icon_card_corner_radius"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/ib_Instagram"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:contentDescription="@null"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:padding="@dimen/share_icon_card_padding"
                        android:src="@drawable/ic_instagram" />
                </androidx.cardview.widget.CardView>

                <!-- More -->
                <androidx.cardview.widget.CardView
                    android:layout_width="@dimen/share_icon_size"
                    android:layout_height="@dimen/share_icon_size"
                    android:layout_margin="@dimen/share_icon_card_margin"
                    android:backgroundTint="#F6F6F6"
                    app:cardCornerRadius="@dimen/share_icon_card_corner_radius"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/ib_Other"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:contentDescription="@null"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:padding="@dimen/share_icon_card_padding"
                        android:src="@drawable/ic_share" />
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/icBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">

        <include
            android:id="@+id/container_native_item"
            layout="@layout/ads_native_container_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/share_ad_margin_top" />
    </LinearLayout>


</RelativeLayout>
