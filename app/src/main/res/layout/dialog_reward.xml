<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/dialog_reward_margin"
    app:cardCornerRadius="@dimen/dialog_reward_corner_radius"
    app:cardElevation="@dimen/dialog_reward_elevation"
    app:cardPreventCornerOverlap="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_rounded"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/dialog_reward_padding">

        <!-- Confetti/Celebration Icon -->
        <ImageView
            android:id="@+id/iv_reward_icon"
            android:layout_width="@dimen/dialog_reward_icon_size"
            android:layout_height="@dimen/dialog_reward_icon_size"
            android:contentDescription="@null"
            android:src="@drawable/ic_win" />

        <!-- Congratulations Text -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dialog_reward_title_margin_top"
            android:text="🎉 Congratulations!"
            android:textColor="@color/charcoal_gray"
            android:textSize="@dimen/dialog_reward_title_text_size"
            android:includeFontPadding="false"
            android:fontFamily="@font/quicksand_semibold" />

        <!-- You Earned Text -->
        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dialog_reward_subtitle_margin_top"
            android:text="You earned"
            android:fontFamily="@font/quicksand_medium"
            android:includeFontPadding="false"
            android:textColor="@color/charcoal_gray"
            android:textSize="@dimen/dialog_reward_subtitle_text_size" />

        <!-- Reward Container -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dialog_reward_container_margin_top"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/dialog_reward_container_padding_h"
            android:paddingVertical="@dimen/dialog_reward_container_padding_v">

            <!-- Reward Icon (Hint/Coin) -->
            <ImageView
                android:id="@+id/iv_reward_type_icon"
                android:layout_width="@dimen/dialog_reward_type_icon_size"
                android:layout_height="@dimen/dialog_reward_type_icon_size"
                android:contentDescription="@null"
                android:src="@drawable/ic_hint" />

            <!-- Reward Amount -->
            <TextView
                android:id="@+id/tv_reward_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dialog_reward_amount_margin_start"
                android:text="1"
                android:includeFontPadding="false"
                android:textColor="@color/charcoal_gray"
                android:textSize="@dimen/dialog_reward_amount_text_size"
                android:fontFamily="@font/quicksand_bold" />

            <!-- Reward Type -->
            <TextView
                android:includeFontPadding="false"
                android:id="@+id/tv_reward_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dialog_reward_type_margin_start"
                android:text="Hint"
                android:textColor="@color/charcoal_gray"
                android:textSize="@dimen/dialog_reward_type_text_size"
                android:fontFamily="@font/quicksand_semibold" />

        </LinearLayout>

        <!-- Description Text -->
        <TextView
            android:id="@+id/tv_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dialog_reward_desc_margin_top"
            android:gravity="center"
            android:includeFontPadding="false"
            android:fontFamily="@font/quicksand_medium"
            android:text="Use your hint wisely!"
            android:textColor="@color/charcoal_gray"
            android:textSize="@dimen/dialog_reward_desc_text_size" />

        <!-- Claim Button -->
        <TextView
            android:id="@+id/btn_claim"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dialog_reward_claim_height"
            android:layout_marginTop="@dimen/dialog_reward_claim_margin_top"
            android:background="@drawable/bg_button_gradient"
            android:gravity="center"
            android:text="CLAIM HINT"
            android:textColor="@color/white"
            android:textSize="@dimen/dialog_reward_claim_text_size"
            android:fontFamily="@font/quicksand_bold" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
