<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/cm_sheet"
    android:orientation="vertical"
    android:padding="@dimen/cm_space_5">

    <TextView
        android:id="@+id/pick_title"
        style="@style/CmText.Section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <EditText
        android:id="@+id/pick_search"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="@dimen/cm_space_3"
        android:background="@drawable/cm_card_tile"
        android:fontFamily="@font/quicksand_medium"
        android:hint="@string/daily_search_hint"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:paddingHorizontal="@dimen/cm_space_4"
        android:textColor="@color/cm_ink"
        android:textColorHint="@color/cm_ink_3"
        android:textSize="14sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/pick_list"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_marginTop="@dimen/cm_space_3"
        android:overScrollMode="never" />

    <Button
        android:id="@+id/pick_auto"
        style="@style/CmButton.Ghost"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/cm_space_3"
        android:text="@string/daily_use_auto" />

</LinearLayout>
