<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <ImageView
        android:id="@+id/iv_replay_canvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter" />

    <!-- Top Bar: Close + Speed Controls -->
    <RelativeLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="#80000000"
        android:padding="8dp">

        <!-- Close Button (Top-End) -->
        <ImageButton
            android:id="@+id/btn_close_replay"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:src="@drawable/round_close_24"
            app:tint="@color/white" />

        <!-- Playback Controls (Center) -->
        <LinearLayout
            android:id="@+id/playback_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Play/Pause Button -->
            <ImageButton
                android:id="@+id/btn_play_pause"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/circle_button_bg"
                android:contentDescription="Play/Pause"
                android:padding="10dp"
                android:src="@drawable/round_pause_24"
                app:tint="@color/white" />

            <!-- Rewind Button -->
            <ImageButton
                android:id="@+id/btn_rewind"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/circle_button_bg"
                android:contentDescription="Rewind"
                android:padding="10dp"
                android:src="@drawable/round_fast_rewind_24"
                app:tint="@color/white" />

            <!-- Speed Indicator Badge -->
            <TextView
                android:id="@+id/tv_speed_indicator"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/speed_badge_bg"
                android:fontFamily="@font/quicksand_bold"
                android:gravity="center"
                android:minWidth="52dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="1x"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <!-- Fast-Forward Button -->
            <ImageButton
                android:id="@+id/btn_fast_forward"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/circle_button_bg"
                android:contentDescription="Fast Forward"
                android:padding="10dp"
                android:src="@drawable/round_fast_forward_24"
                app:tint="@color/white" />

        </LinearLayout>

    </RelativeLayout>

    <!-- Bottom Bar: Progress + Label -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#80000000"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Time / Step Counter -->
        <TextView
            android:id="@+id/tv_step_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:fontFamily="@font/quicksand_bold"
            android:text="0 / 0"
            android:textColor="#B0FFFFFF"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/pb_replay_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:progressDrawable="@drawable/custom_progress_white" />

        <TextView
            android:id="@+id/tv_replay_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:fontFamily="@font/quicksand_bold"
            android:text="Fast-Forward Masterpiece"
            android:textColor="@color/white"
            android:textSize="14sp" />
    </LinearLayout>

</RelativeLayout>