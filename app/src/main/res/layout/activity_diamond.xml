<?xml version="1.0" encoding="utf-8"?>
<!--
  Laid out to match the By Number game screen (activity_game.xml) piece for piece, at the owner's
  request: same rounded bg_hint_btn containers, back top-left, counter top-right, tool rail on the
  left, two round buttons bottom-right, and the palette in a rounded strip along the bottom.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cm_surface_dim">

    <com.colourmate.paintbynumber.model.diamond.DiamondView
        android:id="@+id/diamond_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/fl_diamond_palette"
        android:layout_alignParentTop="true" />

    <!-- Back -->
    <FrameLayout
        android:id="@+id/fl_diamond_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_marginStart="@dimen/main_content_padding_h"
        android:layout_marginTop="@dimen/main_top_bar_margin_top"
        android:background="@drawable/cm_glass_panel"
        android:padding="14dp">

        <ImageView
            android:id="@+id/iv_diamond_back"
            android:layout_width="@dimen/main_nav_icon_size"
            android:layout_height="@dimen/main_nav_icon_size"
            android:contentDescription="@string/todo"
            android:src="@drawable/round_arrow_back_24"
            app:tint="@color/cm_ink" />
    </FrameLayout>

    <!-- Progress, where the game keeps its hint counter -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@id/fl_diamond_back"
        android:layout_alignParentEnd="true"
        android:layout_alignTop="@id/fl_diamond_back"
        android:layout_marginEnd="@dimen/main_content_padding_h"
        android:background="@drawable/cm_glass_panel"
        android:paddingHorizontal="18dp">

        <TextView
            android:id="@+id/tv_diamond_progress"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:fontFamily="@font/quicksand_bold"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="0%"
            android:textColor="@color/cm_violet"
            android:textSize="17sp" />
    </FrameLayout>

    <!-- Tool rail -->
    <LinearLayout
        android:id="@+id/ll_diamond_tools"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_below="@id/fl_diamond_back"
        android:layout_marginStart="@dimen/main_content_padding_h"
        android:layout_marginTop="18dp"
        android:background="@drawable/cm_glass_panel"
        android:orientation="vertical"
        android:padding="6dp">

        <ImageView
            android:id="@+id/btn_diamond_loupe"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/cm_tool_bg"
            android:contentDescription="@string/todo"
            android:padding="13dp"
            android:src="@drawable/ic_zoom_in"
            app:tint="@color/cm_ink_2" />

        <ImageView
            android:id="@+id/btn_diamond_next"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/cm_tool_bg"
            android:contentDescription="@string/todo"
            android:padding="13dp"
            android:src="@drawable/ic_magic_wand"
            app:tint="@color/cm_ink_2" />
    </LinearLayout>

    <!-- Bottom-right round buttons, same spot as the game's pen / zoom-out -->
    <FrameLayout
        android:id="@+id/fl_diamond_fit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/fl_diamond_palette"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="@dimen/main_content_padding_h"
        android:layout_marginBottom="16dp"
        android:background="@drawable/cm_glass_panel"
        android:padding="14dp">

        <ImageView
            android:layout_width="@dimen/main_nav_icon_size"
            android:layout_height="@dimen/main_nav_icon_size"
            android:contentDescription="@string/todo"
            android:src="@drawable/ic_zoom_in" />
    </FrameLayout>

    <!-- Bottom banner ad — same container the By Number and reveal games use -->
    <LinearLayout
        android:id="@+id/ll_diamond_ads"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">

        <include
            android:id="@+id/container_banner"
            layout="@layout/ads_banner_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Palette strip -->
    <FrameLayout
        android:id="@+id/fl_diamond_palette"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/ll_diamond_ads"
        android:layout_marginHorizontal="@dimen/main_content_padding_h"
        android:layout_marginBottom="14dp"
        android:background="@drawable/cm_glass_panel"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_diamond_palette"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingVertical="4dp" />
    </FrameLayout>

    <ProgressBar
        android:id="@+id/pb_diamond_loading"
        android:layout_width="@dimen/tab_loading_size"
        android:layout_height="@dimen/tab_loading_size"
        android:layout_centerInParent="true"
        android:indeterminate="true"
        android:indeterminateTint="@color/cm_violet"
        android:indeterminateTintMode="src_in" />

    <!-- Completion sheet — the finish used to be a Toast here too (see activity_reveal). -->
    <FrameLayout
        android:id="@+id/fl_diamond_done"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66201636"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:id="@+id/ll_diamond_done_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_margin="18dp"
            android:background="@drawable/cm_card"
            android:elevation="10dp"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/diamond_done_title"
                android:textColor="@color/cm_ink"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/diamond_done_sub"
                android:textColor="@color/cm_ink_2"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_diamond_done_close"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/cm_btn_primary"
                android:text="@string/reveal_done_close"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

</RelativeLayout>
