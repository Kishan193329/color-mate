<?xml version="1.0" encoding="utf-8"?>
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ad_view"
    android:background="@color/background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/ad_item_outer_margin">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/ad_app_icon"
                android:layout_width="@dimen/ad_icon_size_small"
                android:layout_height="@dimen/ad_icon_size_small"
                android:layout_marginTop="@dimen/ad_item_icon_margin_v"
                android:layout_marginBottom="@dimen/ad_item_icon_margin_v"
                android:adjustViewBounds="true"
                android:layout_marginStart="@dimen/ad_item_icon_margin_start"
                android:layout_marginEnd="@dimen/ad_item_icon_margin_end"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/ad_item_badge_text_size"
                        android:textColor="#ffffff"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/imgAds"
                        android:background="@drawable/bg_ad_btn_banner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ad"
                        android:textAllCaps="true"
                        android:paddingStart="@dimen/ad_item_badge_padding_h"
                        android:paddingEnd="@dimen/ad_item_badge_padding_h"
                        android:layout_marginStart="@dimen/ad_item_badge_margin_start"/>
                    <TextView
                        android:textSize="@dimen/ad_item_headline_text_size"
                        android:textStyle="bold"
                        android:textColor="@color/charcoal_gray"
                        android:ellipsize="end"
                        android:id="@+id/ad_headline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/ad_item_headline_margin_start"/>
                </LinearLayout>
                <TextView
                    android:textSize="@dimen/ad_item_body_text_size"
                    android:textColor="#7d7d7d"
                    android:ellipsize="end"
                    android:id="@+id/ad_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ad_item_body_margin_top"
                    android:maxLines="2"/>
                <Button
                    android:textSize="@dimen/ad_item_cta_text_size"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/ad_call_to_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAllCaps="true"
                    android:backgroundTint="@color/hint_text_color"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.gms.ads.nativead.NativeAdView>
