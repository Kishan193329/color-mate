<?xml version="1.0" encoding="utf-8"?>
<!--
  Colour Mate type + widget styles.

  The display face is Quicksand, which already ships in the APK (res/font) — a rounded
  grotesque, warm without being childish, and it costs no extra download. Titan One stays
  reserved for the wordmark alone; used more widely it turns the app into a poster.
-->
<resources>

    <!-- ============ TYPE ============ -->
    <style name="CmText">
        <item name="android:fontFamily">@font/quicksand_medium</item>
        <item name="android:textColor">@color/cm_ink</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Display / hero. Onboarding headlines, empty states. -->
    <style name="CmText.Display">
        <item name="android:fontFamily">@font/quicksand_bold</item>
        <item name="android:textSize">@dimen/cm_text_display</item>
        <item name="android:lineSpacingMultiplier">1.05</item>
        <item name="android:letterSpacing">-0.03</item>
    </style>

    <!-- Screen titles. -->
    <style name="CmText.Title">
        <item name="android:fontFamily">@font/quicksand_bold</item>
        <item name="android:textSize">@dimen/cm_text_title</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- Row headers: "Continue colouring", "Trending". -->
    <style name="CmText.Section">
        <item name="android:fontFamily">@font/quicksand_bold</item>
        <item name="android:textSize">@dimen/cm_text_section</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <!-- Card and tile titles. -->
    <style name="CmText.Card">
        <item name="android:fontFamily">@font/quicksand_semibold</item>
        <item name="android:textSize">@dimen/cm_text_card</item>
    </style>

    <style name="CmText.Body">
        <item name="android:fontFamily">@font/quicksand_regular</item>
        <item name="android:textSize">@dimen/cm_text_body</item>
        <item name="android:textColor">@color/cm_ink_2</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
    </style>

    <!-- All-caps eyebrow: "CONTINUE", "PALETTE". -->
    <style name="CmText.Label">
        <item name="android:fontFamily">@font/quicksand_bold</item>
        <item name="android:textSize">@dimen/cm_text_micro</item>
        <item name="android:textColor">@color/cm_ink_2</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="CmText.Caption">
        <item name="android:fontFamily">@font/quicksand_regular</item>
        <item name="android:textSize">@dimen/cm_text_caption</item>
        <item name="android:textColor">@color/cm_ink_3</item>
    </style>

    <!-- Numbers that must line up: stats, prices, timers. -->
    <style name="CmText.Data">
        <item name="android:fontFamily">@font/quicksand_bold</item>
        <item name="android:textSize">@dimen/cm_text_card</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <!-- ============ BUTTONS ============ -->
    <style name="CmButton">
        <!--
          Under a MaterialComponents theme a plain <Button> inflates as MaterialButton, which
          ignores android:background and paints its own tint instead — that is what turned the
          violet gradient into a pale lavender wash. Clearing both tints hands the background back
          to our drawable. Set in the base style so every CmButton variant inherits the fix.
        -->
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:layout_height">@dimen/cm_btn_height</item>
        <item name="android:minWidth">120dp</item>
        <item name="android:paddingHorizontal">@dimen/cm_space_6</item>
        <item name="android:background">@drawable/cm_btn_primary</item>
        <item name="android:fontFamily">@font/quicksand_bold</item>
        <item name="android:textSize">@dimen/cm_text_body</item>
        <item name="android:textColor">@color/cm_surface</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="CmButton.Ghost">
        <item name="android:background">@drawable/cm_btn_ghost</item>
        <item name="android:textColor">@color/cm_violet</item>
    </style>

    <style name="CmButton.Soft">
        <item name="android:background">@drawable/cm_btn_soft</item>
        <item name="android:textColor">@color/cm_violet</item>
    </style>

    <style name="CmButton.Gold">
        <item name="android:background">@drawable/cm_btn_gold</item>
        <item name="android:textColor">@color/cm_gold_ink</item>
    </style>

    <style name="CmButton.Small">
        <item name="android:layout_height">@dimen/cm_btn_height_sm</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingHorizontal">@dimen/cm_space_4</item>
        <item name="android:textSize">@dimen/cm_text_label</item>
    </style>

    <!-- ============ CHIPS ============ -->
    <style name="CmChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:paddingHorizontal">@dimen/cm_space_3</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/cm_chip_violet</item>
        <item name="android:fontFamily">@font/quicksand_bold</item>
        <item name="android:textSize">@dimen/cm_text_caption</item>
        <item name="android:textColor">#FF5B4A9E</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="CmChip.Turquoise">
        <item name="android:background">@drawable/cm_chip_turquoise</item>
        <item name="android:textColor">#FF12907F</item>
    </style>

    <style name="CmChip.Blossom">
        <item name="android:background">@drawable/cm_chip_blossom</item>
        <item name="android:textColor">#FFC4457B</item>
    </style>

    <style name="CmChip.Gold">
        <item name="android:background">@drawable/cm_chip_gold</item>
        <item name="android:textColor">#FF9A6A0C</item>
    </style>

    <!-- ============ CONTAINERS ============ -->
    <style name="CmCard">
        <item name="android:background">@drawable/cm_card</item>
        <item name="android:padding">@dimen/cm_card_padding</item>
        <item name="android:elevation">@dimen/cm_elev_card</item>
    </style>


    <!-- ============ SETTINGS ROWS ============ -->
    <style name="CmSettingsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <!-- Hairline between rows, inset so it starts under the label rather than the icon. -->
    <style name="CmRowDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">46dp</item>
        <item name="android:background">@color/cm_line</item>
    </style>

</resources>
