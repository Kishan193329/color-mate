<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="19dp" />
            <gradient android:angle="300" android:startColor="#FFFFC24B" android:endColor="#FFFF8A5B" android:type="linear" />
        </shape>
    </item>
    <!-- top highlight: the lift comes from this, not from a shadow -->
    <item android:bottom="26dp">
        <shape android:shape="rectangle">
            <corners android:radius="19dp" />
            <gradient android:angle="270" android:startColor="#59FFFFFF" android:endColor="#00FFFFFF" android:type="linear" />
        </shape>
    </item>
</layer-list>
