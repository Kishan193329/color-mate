<?xml version="1.0" encoding="utf-8"?>
<!-- cm_glass_panel for a WHITE canvas (the pixel game): the translucent version vanishes on
     white, so this one is opaque with the hairline the icon buttons use, and elevation gives it
     a real shadow. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="@dimen/cm_radius_md" />
    <solid android:color="@color/cm_surface" />
    <stroke android:width="1dp" android:color="@color/cm_line" />
</shape>
