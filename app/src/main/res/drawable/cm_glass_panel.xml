<?xml version="1.0" encoding="utf-8"?>
<!--
  Chrome that floats over artwork. Near-white and translucent so the canvas shows through at the
  edges — in the workspace the picture owns the screen and the controls stay out of its way.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="@dimen/cm_radius_md" />
    <solid android:color="#D1FFFFFF" />
    <stroke android:width="1dp" android:color="#59FFFFFF" />
</shape>
