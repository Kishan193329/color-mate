<?xml version="1.0" encoding="utf-8"?>
<!--
  UNSELECTED plan chip.

  This was solid #FFFFFF — which on the violet card rendered as a blank white box with the white
  label and price invisible inside it. Translucent instead, so the chip recedes but stays legible.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#1FFFFFFF" />
    <stroke android:width="1dp" android:color="#4DFFFFFF" />
    <corners android:radius="@dimen/cm_radius_sm" />
</shape>
