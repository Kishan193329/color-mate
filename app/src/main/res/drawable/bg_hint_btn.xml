<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Main Background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/hint_bg_color" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Inner Highlight (Top Edge Offset) -->
    <item
        android:bottom="1.5dp"
        android:left="1.5dp"
        android:right="1.5dp"
        android:top="1.5dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/hint_inner_highlight" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Subtle Shadow/Base layer if needed, but the above layer-list should create a nice 3D effect -->
</layer-list>
