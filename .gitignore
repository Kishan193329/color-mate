# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Node
node_modules/
dist/
.vite/

# Job artifacts (keep the folder, ignore contents)
storage/jobs/*
!storage/jobs/.gitkeep

# Runtime AI-mode override (written by the AI settings panel)
storage/ai_settings.json

# Local AI line-art model weights (auto-downloaded on first use; too large for git)
backend/models/

# Experience Learning store — keep the structure, ignore the runtime feedback records
experience/rejections/*
!experience/rejections/.gitkeep
experience/approved/*
!experience/approved/.gitkeep
experience/patterns/*
!experience/patterns/.gitkeep

# Env / OS
.env
.DS_Store
Thumbs.db
