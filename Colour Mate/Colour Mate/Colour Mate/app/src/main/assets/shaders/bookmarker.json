{
	"name": "marker", 
	"shader": "shaders/booknewmarker.fsh",
    "uniforms": {
        "markerMode": "r1"
    },
    
    "inputs": {
        "overlay": {
        	"path": ["assets/marker1.jpg", "assets/marker2.jpg"],
			"mipmaps": true,
			"repeat": true
		},
        "background": {
        	"path": "assets/booksheet_art3.jpg",
			"mipmaps": true,
			"repeat": true
        },
        "lut": {
            "global_lut": true
        }
    },
    
    "uvmatrix": {
    	"type": "randomfree",
    	"allowxflip": true,
    	"allowyflip": true, 
    	"scale": 1.333,
    	"scale_random": 0.333
    }
}
