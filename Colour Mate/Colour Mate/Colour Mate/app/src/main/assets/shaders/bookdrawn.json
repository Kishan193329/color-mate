{
	"shader": "shaders/bookdrawn.fsh",
	"autoblurmaps": false, 
    
    "inputs": {
        "noise": {
        	"path": "assets/noise.png",
			"mipmaps": true,
			"repeat": true
		},
        "hatch": {
        	"path": "assets/pencil_testing.jpg",
			"mipmaps": true,
			"repeat": true
		},
        "disp": {
        	"path": "assets/pencil_disturb.jpg",
			"mipmaps": true,
			"repeat": true
		},
        "lut": {
            "global_lut": true
        }
    },
        
    "uvmatrix": {
    	"type": "randomfree",
    	"allowxflip": true,
    	"allowyflip": true, 
    	"scale": 1.0,
    	"scale_random": 0.0
    }
}
