uniform sampler2D tex;
uniform sampler2D outline;
varying highp vec2 texCoord;
void main ()
{
  mediump float r;
  mediump vec4 y;
  lowp vec4 g;
  g = texture2D (tex, texCoord);
  y = g;
  highp vec2 x;
  x = texCoord;
  highp float z;
  z = 1.0;
  for (mediump float b = -2.0; b <= 2.0; b += 1.0) {
    mediump float a;
    a = -2.0;
    highp vec2 _;
    mediump vec2 A;
    A.x = a;
    A.y = b;
    _ = A;
    highp float Y;
    highp float R;
    R = (-2.0 - x.x);
    highp float X;
    X = (b - x.y);
    Y = sqrt(((R * R) + (X * X)));
    if ((Y <= 2.0)) {
      highp float W;
      mediump vec4 Z;
      highp vec2 o;
      o = (x + (_ * vec2(0.0004882812, 0.0004882812)));
      Z = texture2D (outline, o);
      mediump float O;
      O = (clamp (Z.x, 0.0, 0.75) * 1.5);
      W = O;
      z = min (z, W);
    };
    a = -1.0;
    highp vec2 I;
    mediump vec2 i;
    i.x = a;
    i.y = b;
    I = i;
    highp float l;
    highp float S;
    S = (-1.0 - x.x);
    highp float G;
    G = (b - x.y);
    l = sqrt(((S * S) + (G * G)));
    if ((l <= 2.0)) {
      highp float B;
      mediump vec4 c;
      highp vec2 d;
      d = (x + (I * vec2(0.0004882812, 0.0004882812)));
      c = texture2D (outline, d);
      mediump float e;
      e = (clamp (c.x, 0.0, 0.75) * 1.5);
      B = e;
      z = min (z, B);
    };
    a = 0.0;
    highp vec2 f;
    mediump vec2 h;
    h.x = a;
    h.y = b;
    f = h;
    highp float j;
    highp float k;
    k = -(x.x);
    highp float m;
    m = (b - x.y);
    j = sqrt(((k * k) + (m * m)));
    if ((j <= 2.0)) {
      highp float n;
      mediump vec4 p;
      highp vec2 q;
      q = (x + (f * vec2(0.0004882812, 0.0004882812)));
      p = texture2D (outline, q);
      mediump float s;
      s = (clamp (p.x, 0.0, 0.75) * 1.5);
      n = s;
      z = min (z, n);
    };
    a = 1.0;
    highp vec2 t;
    mediump vec2 u;
    u.x = a;
    u.y = b;
    t = u;
    highp float v;
    highp float C;
    C = (1.0 - x.x);
    highp float D;
    D = (b - x.y);
    v = sqrt(((C * C) + (D * D)));
    if ((v <= 2.0)) {
      highp float E;
      mediump vec4 F;
      highp vec2 H;
      H = (x + (t * vec2(0.0004882812, 0.0004882812)));
      F = texture2D (outline, H);
      mediump float J;
      J = (clamp (F.x, 0.0, 0.75) * 1.5);
      E = J;
      z = min (z, E);
    };
    a = 2.0;
    highp vec2 K;
    mediump vec2 L;
    L.x = a;
    L.y = b;
    K = L;
    highp float M;
    highp float N;
    N = (2.0 - x.x);
    highp float P;
    P = (b - x.y);
    M = sqrt(((N * N) + (P * P)));
    if ((M <= 2.0)) {
      highp float Q;
      mediump vec4 T;
      highp vec2 U;
      U = (x + (K * vec2(0.0004882812, 0.0004882812)));
      T = texture2D (outline, U);
      mediump float V;
      V = (clamp (T.x, 0.0, 0.75) * 1.5);
      Q = V;
      z = min (z, Q);
    };
    a = 3.0;
  };
  r = z;
  mediump vec4 wr;
  wr.xyz = y.xyz;
  wr.w = r;
  gl_FragColor = wr;
}

