        	"path": ["assets/penciltesting2.jpg","assets/penciltesting6.jpg","assets/penciltesting8.jpg","assets/penciltesting9.jpg"],
			"mipmaps": true,
			"repeat": true
		},
        "background": {
        	"path": "assets/booksheet_art3.jpg",
			"mipmaps": true,
			"repeat": true
		},
		"noise": {
        	"path": "assets/pencil_disturb.jpg",
			"mipmaps": true,
			"repeat": true
        },
