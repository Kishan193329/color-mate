<?xml version="1.0" encoding="utf-8"?>
<!--
  Favourite button on artwork. The plain 85%-white circle was invisible, because every picture
  underneath it is white line art. A hairline edge gives it a shape to read against.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <solid android:color="#F2FFFFFF" />
    <stroke android:width="1dp" android:color="#1A000000" />
</shape>
