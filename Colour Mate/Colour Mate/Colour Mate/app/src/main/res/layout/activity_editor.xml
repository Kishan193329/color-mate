<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true">


    <RelativeLayout
        android:layout_above="@+id/ll_ads"
        android:layout_alignWithParentIfMissing="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.colourmate.paintbynumber.views.DrawingView
            android:id="@+id/sv_draw"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null" />
    </RelativeLayout>

    <ProgressBar
        android:id="@+id/progressView"
        android:layout_width="@dimen/editor_progress_size"
        android:layout_height="@dimen/editor_progress_size"
        android:layout_centerInParent="true"
        android:indeterminate="true"
        android:indeterminateTint="@color/hint_text_color"
        android:indeterminateTintMode="src_in"/>


    <RelativeLayout
        android:id="@android:id/home"
        android:layout_width="@dimen/toolbar_back_btn_size"
        android:layout_height="@dimen/toolbar_back_btn_size"
        android:layout_gravity="center_vertical"
        android:layout_margin="@dimen/editor_back_margin"
        android:background="@drawable/round_background"
        android:onClick="onClickHome">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:contentDescription="@string/todo"
            android:src="@drawable/round_arrow_back_24" />

    </RelativeLayout>


    <LinearLayout
        android:id="@+id/ll_ads"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/editor_ads_margin_top"
        android:layout_marginBottom="@dimen/editor_ads_margin_bottom"
        android:layout_alignParentBottom="true">
        <include
            android:id="@+id/container_banner"
            layout="@layout/ads_banner_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

</RelativeLayout>
