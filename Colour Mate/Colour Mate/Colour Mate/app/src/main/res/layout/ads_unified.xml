<?xml version="1.0" encoding="utf-8"?>
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.gms.ads.nativead.MediaView
            android:layout_gravity="center_horizontal"
            android:id="@+id/ad_media"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ad_media_height"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/conIcon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ad_view_section_margin_top"
            android:layout_marginStart="@dimen/ad_view_section_margin_h"
            android:layout_marginEnd="@dimen/ad_view_section_margin_h"
            app:layout_constraintTop_toBottomOf="@+id/ad_media">
            <ImageView
                android:id="@+id/ad_app_icon"
                android:layout_width="@dimen/ad_icon_size"
                android:layout_height="@dimen/ad_icon_size"
                android:adjustViewBounds="true"
                app:layout_constraintBottom_toTopOf="@+id/ad_call_to_action"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/ad_item_badge_text_size"
                android:textColor="#ffffff"
                android:id="@+id/imgAds"
                android:background="@drawable/bg_ad_btn_banner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ad"
                android:paddingStart="@dimen/ad_item_badge_padding_h"
                android:paddingEnd="@dimen/ad_item_badge_padding_h"
                android:layout_marginStart="@dimen/ad_view_badge_margin_start"
                app:layout_constraintBottom_toBottomOf="@+id/ad_headline"
                app:layout_constraintStart_toEndOf="@+id/ad_app_icon"
                app:layout_constraintTop_toTopOf="@+id/ad_headline"/>
            <TextView
                android:textSize="@dimen/ad_view_headline_text_size"
                android:textStyle="bold"
                android:textColor="@color/charcoal_gray"
                android:ellipsize="end"
                android:id="@+id/ad_headline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="@dimen/ad_view_content_margin_h"
                android:layout_marginEnd="@dimen/ad_view_content_margin_h"
                app:layout_constraintBottom_toTopOf="@+id/ad_body"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/imgAds"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/ad_item_body_text_size"
                android:textColor="#7a7a7a"
                android:ellipsize="end"
                android:id="@+id/ad_body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ad_view_body_margin_top"
                android:maxLines="2"
                android:layout_marginStart="@dimen/ad_view_content_margin_h"
                android:layout_marginEnd="@dimen/ad_view_content_margin_h"
                app:layout_constraintBottom_toBottomOf="@+id/ad_app_icon"
                app:layout_constraintBottom_toTopOf="@+id/ad_call_to_action"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/ad_app_icon"
                app:layout_constraintTop_toBottomOf="@+id/ad_headline"/>
            <Button
                android:textSize="@dimen/ad_item_cta_text_size"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/ad_call_to_action"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAllCaps="true"
                android:backgroundTint="@color/hint_text_color"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ad_body"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.gms.ads.nativead.NativeAdView>
