<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="6dp">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:background="@drawable/bg_hint_btn"
            android:padding="@dimen/game_btn_icon_padding_inner"
            android:orientation="vertical">

            <!-- Turbo Brush -->
            <LinearLayout
                android:id="@+id/btn_tool_brush"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Turbo Brush"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_paint_brush_24"
                    app:tint="@color/selector_tool_content" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    
                    android:duplicateParentState="true"
                    android:fontFamily="@font/quicksand_semibold"
                    android:includeFontPadding="false"
                    android:text="Brush"
                    android:textColor="@color/selector_tool_content"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Color Bomb -->
            <LinearLayout
                android:id="@+id/btn_tool_bomb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:visibility="gone">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Color Bomb"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_bomb_24"
                    app:tint="@color/selector_tool_content" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    
                    android:duplicateParentState="true"
                    android:fontFamily="@font/quicksand_semibold"
                    android:includeFontPadding="false"
                    android:text="Bomb"
                    android:textColor="@color/selector_tool_content"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Paint Bucket -->
            <LinearLayout
                android:id="@+id/btn_tool_bucket"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="vertical"
                >

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Paint Bucket"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_paint_bucket_24"
                    app:tint="@color/hint_text_color" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    
                    android:duplicateParentState="true"
                    android:fontFamily="@font/quicksand_semibold"
                    android:includeFontPadding="false"
                    android:text="Bucket"
                    android:textColor="@color/hint_text_color"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Magnifier -->
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/btn_tool_loupe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:layout_gravity="center"
                android:visibility="gone">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Magnifier"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_magnifier_24"
                    app:tint="@color/selector_tool_content" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    
                    android:duplicateParentState="true"
                    android:fontFamily="@font/quicksand_semibold"
                    android:includeFontPadding="false"
                    android:text="Loupe"
                    android:textColor="@color/hint_text_color"
                    android:textSize="9sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_gravity="center"
                android:gravity="center"
                android:layout_marginVertical="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="15dp"
                    android:backgroundTint="@color/hint_text_color"
                    android:background="@drawable/bg_bottom_sheet_handle"
                    android:layout_height="1.5dp"/>

            </LinearLayout>

            <!-- Radar Scanner -->
            <LinearLayout
                android:id="@+id/btn_tool_radar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_gravity="center"
                >

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Radar"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_radar_24"
                    app:tint="@color/hint_text_color" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    
                    android:duplicateParentState="true"
                    android:fontFamily="@font/quicksand_semibold"
                    android:includeFontPadding="false"
                    android:text="Radar"
                    android:textColor="@color/hint_text_color"
                    android:textSize="9sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_gravity="center"
                android:gravity="center"
                android:layout_marginVertical="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="15dp"
                    android:backgroundTint="@color/hint_text_color"
                    android:background="@drawable/bg_bottom_sheet_handle"
                    android:layout_height="1.5dp"/>

            </LinearLayout>

            <!-- Chroma Surge -->
            <LinearLayout
                android:id="@+id/btn_tool_surge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_gravity="center"
                >

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Chroma Surge"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_surge_24"
                    app:tint="@color/hint_text_color" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    
                    android:duplicateParentState="true"
                    android:fontFamily="@font/quicksand_semibold"
                    android:includeFontPadding="false"
                    android:text="Surge"
                    android:textColor="@color/hint_text_color"
                    android:textSize="9sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_gravity="center"
                android:gravity="center"
                android:layout_marginVertical="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="15dp"
                    android:backgroundTint="@color/hint_text_color"
                    android:background="@drawable/bg_bottom_sheet_handle"
                    android:layout_height="1.5dp"/>

            </LinearLayout>

            <!-- Magic Wand -->
            <LinearLayout
                android:id="@+id/btn_tool_wand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_gravity="center"
                >

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Magic Wand"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_magic_wand"
                    app:tint="@color/hint_text_color" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    
                    android:duplicateParentState="true"
                    android:fontFamily="@font/quicksand_semibold"
                    android:includeFontPadding="false"
                    android:text="Wand"
                    android:textColor="@color/hint_text_color"
                    android:textSize="9sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_gravity="center"
                android:gravity="center"
                android:layout_marginVertical="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="15dp"
                    android:backgroundTint="@color/hint_text_color"
                    android:background="@drawable/bg_bottom_sheet_handle"
                    android:layout_height="1.5dp"/>

            </LinearLayout>

            <!-- Smart Magnet -->
            <LinearLayout
                android:id="@+id/btn_tool_magnet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:orientation="vertical"
                android:focusable="true"
                android:gravity="center"
                android:layout_gravity="center"
                >

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Smart Magnet"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_magnet"
                    app:tint="@color/hint_text_color" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:fontFamily="@font/quicksand_semibold"
                    android:includeFontPadding="false"
                    android:text="Magnet"
                    android:textColor="@color/hint_text_color"
                    android:textSize="9sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</FrameLayout>
