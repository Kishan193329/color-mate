<?xml version="1.0" encoding="utf-8"?>
<!-- Coins sheet (2026-10-14): balance, earn (rewarded video), or remove the need (Premium). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_coins_sheet"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/cm_space_5"
    android:paddingTop="@dimen/cm_space_4"
    android:paddingBottom="@dimen/cm_space_5">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/cm_line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cm_space_4"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/todo"
            android:src="@drawable/cm_ic_coin" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/cm_space_3"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_coins_balance"
                style="@style/CmText.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0" />

            <TextView
                style="@style/CmText.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your coins · a hint costs 20" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_coins_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/cm_icon_btn"
            android:contentDescription="Close"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/cm_ink_2" />
    </LinearLayout>

    <TextView
        style="@style/CmText.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cm_space_4"
        android:text="+50 every day, +20 for every picture you finish. Spend them on premium pictures, the Hit picture and hints." />

    <TextView
        android:id="@+id/btn_coins_watch"
        style="@style/CmButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cm_space_4"
        android:text="Watch a short video  ·  +30 coins" />

    <TextView
        style="@style/CmText.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cm_space_4"
        android:text="Coin packs" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cm_space_2"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/btn_pack_0"
            style="@style/CmButton.Soft"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:minWidth="0dp"
            android:paddingHorizontal="4dp" />
        <TextView
            android:id="@+id/btn_pack_1"
            style="@style/CmButton.Soft"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:minWidth="0dp"
            android:paddingHorizontal="4dp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cm_space_2"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/btn_pack_2"
            style="@style/CmButton.Soft"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:minWidth="0dp"
            android:paddingHorizontal="4dp" />
        <TextView
            android:id="@+id/btn_pack_3"
            style="@style/CmButton.Soft"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:minWidth="0dp"
            android:paddingHorizontal="4dp" />
    </LinearLayout>

    <TextView
        style="@style/CmText.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cm_space_4"
        android:text="Invite friends" />

    <TextView
        android:id="@+id/tv_ref_info"
        style="@style/CmText.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cm_space_1"
        android:text="A friend joins on a new phone with your code: you get 200, they get 100, and you earn 10% of every picture they finish." />

    <TextView
        android:id="@+id/btn_ref_share"
        style="@style/CmButton.Gold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cm_space_2"
        android:text="Share my code" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cm_space_2"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/et_ref_code"
            android:layout_width="0dp"
            android:layout_height="@dimen/cm_btn_height"
            android:layout_weight="1"
            android:background="@drawable/cm_card"
            android:hint="Friend's code"
            android:importantForAutofill="no"
            android:inputType="textCapCharacters"
            android:maxLength="8"
            android:paddingHorizontal="@dimen/cm_space_4"
            android:textColor="@color/cm_ink" />

        <TextView
            android:id="@+id/btn_ref_redeem"
            style="@style/CmButton.Soft"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/cm_btn_height"
            android:layout_marginStart="@dimen/cm_space_2"
            android:minWidth="0dp"
            android:text="Use" />
    </LinearLayout>

    <TextView
        android:id="@+id/btn_coins_premium"
        style="@style/CmButton.Ghost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cm_space_2"
        android:text="Go Premium — unlimited hints, no ads" />

</LinearLayout>

</ScrollView>
